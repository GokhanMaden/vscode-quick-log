{
  "name": "quick-log",
  "displayName": "Quick Log",
  "description": "Insert console.log for the selected variable with one shortcut.",
  "version": "0.1.0",
  "publisher": "gokhanmaden",
  "author": "Gökhan Maden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GokhanMaden/vscode-quick-log"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "console.log",
    "debug",
    "javascript",
    "typescript",
    "react"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quickLog.insertLog",
        "title": "Insert console.log",
        "category": "Quick Log"
      }
    ],
    "keybindings": [
      {
        "command": "quickLog.insertLog",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(javascript|typescript)(react)?$/"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quickLog.insertLog",
          "when": "editorLangId =~ /^(javascript|typescript)(react)?$/"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
