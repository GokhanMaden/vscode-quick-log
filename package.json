{
  "name": "vscode-quick-log-by-maden",
  "displayName": "Quick Log — Smart console.log",
  "description": "Insert console.log for the selected variable with one shortcut.",
  "version": "0.2.0",
  "publisher": "gokhanmaden",
  "author": "Gökhan Maden",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#151A2B",
    "theme": "dark"
  },
  "homepage": "https://github.com/GokhanMaden/vscode-quick-log#readme",
  "bugs": {
    "url": "https://github.com/GokhanMaden/vscode-quick-log/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GokhanMaden/vscode-quick-log"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "console.log",
    "debug",
    "javascript",
    "typescript",
    "react"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quickLog.insertLog",
        "title": "Insert console.log",
        "category": "Quick Log"
      }
    ],
    "keybindings": [
      {
        "command": "quickLog.insertLog",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(javascript|typescript)(react)?$/"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quickLog.insertLog",
          "when": "editorLangId =~ /^(javascript|typescript)(react)?$/"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "bundle:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "watch": "npm run bundle -- --watch",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile && npm run bundle:prod"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
