{
  "version": "2.0.0",
  "tasks": [
    {
      // esbuild --watch keeps running; VS Code waits for "build finished"
      // before launching the Extension Development Host.
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
        "background": {
          "activeBegin": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    }
  ]
}
